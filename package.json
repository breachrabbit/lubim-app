{
  "name": "lubim-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Туристическое мобильное приложение о городе Любим Ярославской области",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:capacitor": "cross-env BUILD_TARGET=capacitor next build",
    "android:init": "npx cap add android",
    "android:sync": "npm run build:capacitor && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "leaflet": "^1.9.4",
    "motion": "^12.23.12",
    "next": "^16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.0"
  }
}
